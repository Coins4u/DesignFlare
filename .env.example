## DesignFlare Lead Notification (SMTP)
#
# Copy to `.env` in this folder (same directory as server.js).
# Node only reads `.env` — editing `.env.example` alone does nothing.
#
# If the site is static HTML on your domain but the API runs elsewhere, add to <head>:
#   <meta name="designflare-api-base" content="https://your-node-host.com/api">

ADMIN_EMAIL=your-management-inbox@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

ORDER_FROM=your-gmail@gmail.com
FROM_NAME=DesignFlare Orders

## Payment links (two separate configs)
# Direct Whop URLs for DesignFlare checkout invoices → lib/tier-payment-links.ts
# Bridged Whop URLs (hidden, /api/pay only)      → lib/pay-bridge-config.ts

## Payment bridge (/api/pay) — external traffic only

PAY_BRIDGE_SECRET=change-me-to-a-long-random-secret
BRIDGE_BASE_URL=https://designflare.de
SITE_URL=https://designflare.de
